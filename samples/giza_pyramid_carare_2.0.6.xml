        <id>ACT-GIZEH-SCAN</id>
      </appellation>
      <description lang="de" preferred="true">Gemeinsame 3D-Erfassungskampagne für Pyramide, Grabkammer, Sarkophag (4 Teile), Mumie und Kanopenkasten samt Inhalt inkl. Ableitung der Low-Poly-Webmodelle.</description>
      <eventType lang="de">Laserscanning (TLS) &amp; Photogrammetrie</eventType>
      <temporal>
        <timeSpan>
          <startDate>2026-11-01</startDate>
          <endDate>2026-11-10</endDate>
        </timeSpan>
        <displayDate lang="de" preferred="true">01.–10.11.2026</displayDate>
      </temporal>
      <spatial>
        <locationSet>
          <namedLocation lang="de" preferred="true">Gizeh, Ägypten</namedLocation>
          <geopoliticalArea lang="de">Ägypten</geopoliticalArea>
        </locationSet>
      </spatial>
      <consistsOf>
        <hadSpecificPurpose lang="de">Digital Authenticity Profile, Dimension 1 von 5: Materielle Spuren und Merkmale (Ausgangsbefund am Objekt)</hadSpecificPurpose>
        <methods lang="de">Verwitterungsspuren am Kalksteinmauerwerk, antike Bearbeitungsspuren am Granitsarkophag und Erhaltungszustand der Grabbeigaben vollständig erfasst.</methods>
      </consistsOf>
      <consistsOf>
        <hadSpecificPurpose lang="de">Digital Authenticity Profile, Dimension 2 von 5: Aufnahmeprozess und Erfassungsumfang</hadSpecificPurpose>
        <methods lang="de">Kombination aus terrestrischem Laserscanning (Leica RTC360) für Architektur und Nahbereichs-Photogrammetrie für Sarkophag, Mumie und Kanopenkasten.</methods>
      </consistsOf>
      <consistsOf>
        <hadSpecificPurpose lang="de">Digital Authenticity Profile, Dimension 3 von 5: Geometrie-Bearbeitung</hadSpecificPurpose>
        <methods lang="de">Registrierung der Einzelscans im lokalen UTM-System (EPSG:32636), Rauschfilterung und Dezimierung zur Erzeugung der 10 Low-Poly-Webderivate.</methods>
      </consistsOf>
      <consistsOf>
        <hadSpecificPurpose lang="de">Digital Authenticity Profile, Dimension 4 von 5: Textur, Shader und Material</hadSpecificPurpose>
        <methods lang="de">Farbkalibrierte Albedo- und Normal-Maps (4K PBR) für die Echtzeit-Webmodelle ohne fiktive Rekonstruktion fehlender Partien.</methods>
      </consistsOf>
      <consistsOf>
        <hadSpecificPurpose lang="de">Digital Authenticity Profile, Dimension 5 von 5: Abbildungsbilanz</hadSpecificPurpose>
        <methods lang="de">Alle sichtbaren Oberflächen und Teilobjekte sind maßstabsgetreu dokumentiert; unzugängliche Aufliegeflächen bleiben transparent gekennzeichnet.</methods>
      </consistsOf>
